#!/usr/bin/env sh
set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
app_prefix="${AIRAN_DESK_APPDIR:-${AIRAN_DESK_PREFIX:-/opt/airan-desk}}"
bindir="${AIRAN_DESK_BINDIR:-$app_prefix/bin}"
libdir="${AIRAN_DESK_LIBDIR:-$app_prefix/lib}"
confdir="${AIRAN_DESK_CONFDIR:-$bindir/conf}"
app_datadir="${AIRAN_DESK_APP_DATADIR:-$app_prefix/share/airan-desk}"
datadir="${AIRAN_DESK_DATADIR:-/usr/local/share}"
udev_rules_dir="${AIRAN_DESK_UDEV_RULES_DIR:-/etc/udev/rules.d}"
manifest="$app_prefix/install-manifest.txt"

if [ "$(id -u)" -ne 0 ]; then
    echo "Please run this installer with sudo/root." >&2
    exit 1
fi

for required_file in airan-desk airan-desk.real airan-desk-ensure-uinput-rule install-linux.sh remove-linux.sh 60-airan-desk-uinput.rules; do
    if [ ! -f "$script_dir/$required_file" ]; then
        echo "Package payload is missing required file: $required_file" >&2
        exit 1
    fi
done
for required_file in LICENSE README.md README.en.md script/airan-notify.sh script/airan-notify.bat script/README.md; do
    if [ ! -f "$script_dir/$required_file" ]; then
        echo "Package payload is missing required file: $required_file" >&2
        exit 1
    fi
done

append_available_package()
{
    for package_name in "$@"; do
        candidate=$(apt-cache policy "$package_name" 2>/dev/null | sed -n 's/^  Candidate: //p' | head -n 1)
        if [ -n "$candidate" ] && [ "$candidate" != "(none)" ]; then
            apt_packages="$apt_packages $package_name"
            return 0
        fi
    done
    echo "Warning: none of these apt packages are available: $*" >&2
}

is_installed_package()
{
    dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q "install ok installed"
}

intel_cpu_model()
{
    awk -F: '
        /^vendor_id[[:space:]]*:/ { vendor=$2; gsub(/^[[:space:]]+|[[:space:]]+$/, "", vendor) }
        /^cpu family[[:space:]]*:/ { family=$2; gsub(/^[[:space:]]+|[[:space:]]+$/, "", family) }
        /^model[[:space:]]*:/ && $1 !~ /name/ { model=$2; gsub(/^[[:space:]]+|[[:space:]]+$/, "", model) }
        vendor == "GenuineIntel" && family == "6" && model != "" { print model; exit }
    ' /proc/cpuinfo 2>/dev/null || true
}

intel_graphics_device_present()
{
    for device in /sys/bus/pci/devices/*; do
        [ -r "$device/vendor" ] && [ -r "$device/class" ] || continue
        vendor=$(cat "$device/vendor" 2>/dev/null || true)
        class=$(cat "$device/class" 2>/dev/null || true)
        case "$vendor:$class" in
            0x8086:0x03*)
                return 0
                ;;
        esac
    done
    return 1
}

detect_intel_vaapi_driver()
{
    case "${AIRAN_DESK_VAAPI_DRIVER:-}" in
        iHD|i965)
            printf '%s\n' "$AIRAN_DESK_VAAPI_DRIVER"
            return 0
            ;;
        auto|"")
            ;;
        skip|none|system)
            return 0
            ;;
        *)
            echo "Warning: unsupported AIRAN_DESK_VAAPI_DRIVER=$AIRAN_DESK_VAAPI_DRIVER; using CPU auto-detect." >&2
            ;;
    esac

    intel_graphics_device_present || return 0

    model=$(intel_cpu_model)
    [ -n "$model" ] || return 0

    case "$model" in
        26|30|37|44|46|42|45|58|62|60|63|69|70)
            printf '%s\n' i965
            ;;
        *)
            printf '%s\n' iHD
            ;;
    esac
}

install_vaapi_driver_package()
{
    vaapi_driver=$(detect_intel_vaapi_driver)
    case "$vaapi_driver" in
        i965)
            append_available_package i965-va-driver
            ;;
        iHD)
            append_available_package intel-media-va-driver-non-free intel-media-va-driver
            ;;
        "")
            return 0
            ;;
        *)
            append_available_package intel-media-va-driver-non-free intel-media-va-driver i965-va-driver
            ;;
    esac
}

write_vaapi_driver_config()
{
    vaapi_driver=$(detect_intel_vaapi_driver)
    vaapi_config="$confdir/linux-vaapi-driver.env"
    if [ -n "$vaapi_driver" ]; then
        {
            printf '%s\n' "# Generated by Airan Desk installer."
            printf '%s\n' "# Override at runtime by setting LIBVA_DRIVER_NAME before launching airan-desk."
            printf 'LIBVA_DRIVER_NAME=%s\n' "$vaapi_driver"
        } > "$vaapi_config"
        chmod 0644 "$vaapi_config"
        append_manifest "$vaapi_config"
        echo "Configured Intel VAAPI driver: $vaapi_driver"
    else
        rm -f "$vaapi_config"
        echo "No Intel VAAPI driver override configured."
    fi
}

install_rpm_dependencies()
{
    package_manager=$1
    packages="alsa-lib pulseaudio-libs kmod passwd systemd hicolor-icon-theme desktop-file-utils fontconfig freetype mesa-libgbm libdrm mesa-libEGL mesa-libGL"
    echo "Installing runtime dependencies with $package_manager:$packages"
    "$package_manager" install -y $packages
}

install_opkg_dependencies()
{
    if [ -n "${AIRAN_DESK_OPKG_PACKAGES:-}" ]; then
        packages=$AIRAN_DESK_OPKG_PACKAGES
    else
        packages="alsa-lib libpulse libdrm libgbm libegl libgl fontconfig freetype kmod udev"
    fi
    echo "Installing runtime dependencies with opkg:$packages"
    opkg update
    opkg install $packages
}

install_apt_runtime_dependencies()
{
    if ! command -v apt-get >/dev/null 2>&1 || ! command -v apt-cache >/dev/null 2>&1 || ! command -v dpkg-query >/dev/null 2>&1; then
        echo "apt-get was not found; the runtime dependency dispatcher selected the wrong backend." >&2
        return 1
    fi

    if ! apt-get update; then
        echo "Failed to update apt package lists." >&2
        echo "Please run this command manually, then retry:" >&2
        echo "  sudo apt-get update" >&2
        exit 1
    fi

    apt_packages=""
    append_available_package libasound2 libasound2t64
    append_available_package libpulse0 libpulse0t64
    append_available_package kmod
    append_available_package passwd
    append_available_package udev
    append_available_package hicolor-icon-theme
    append_available_package desktop-file-utils
    append_available_package libfontconfig1 libfontconfig1t64
    append_available_package libfreetype6
    append_available_package libgbm1 libgbm1t64
    append_available_package libdrm2 libdrm2t64
    install_vaapi_driver_package
    append_available_package libegl1
    append_available_package libgl1

    missing_packages=""
    for package_name in $apt_packages; do
        if ! is_installed_package "$package_name"; then
            missing_packages="$missing_packages $package_name"
        fi
    done

    if [ -z "$missing_packages" ]; then
        return 0
    fi

    echo "Installing missing runtime dependencies:$missing_packages"
    if ! DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends $missing_packages; then
        echo "Failed to install runtime dependencies automatically." >&2
        echo "Please run this command manually, then retry:" >&2
        echo "  sudo apt-get update && sudo apt-get install -y --no-install-recommends$missing_packages" >&2
        exit 1
    fi
}

install_system_dependencies()
{
    if [ "${AIRAN_DESK_SKIP_DEPENDENCIES:-${AIRAN_DESK_SKIP_APT:-0}}" = "1" ]; then
        echo "Skipping runtime dependency installation because AIRAN_DESK_SKIP_DEPENDENCIES=1."
        return 0
    fi

    if command -v apt-get >/dev/null 2>&1 &&
       command -v apt-cache >/dev/null 2>&1 &&
       command -v dpkg-query >/dev/null 2>&1; then
        install_apt_runtime_dependencies
    elif command -v dnf >/dev/null 2>&1; then
        install_rpm_dependencies dnf
    elif command -v yum >/dev/null 2>&1; then
        install_rpm_dependencies yum
    elif command -v opkg >/dev/null 2>&1; then
        install_opkg_dependencies
    else
        echo "No supported package manager was found. Install runtime dependencies manually, or set AIRAN_DESK_SKIP_DEPENDENCIES=1." >&2
    fi
}

append_manifest()
{
    [ -e "$1" ] || return 0
    printf '%s\n' "$1" >> "$manifest_tmp"
}

install_system_dependencies

install -d "$bindir" "$libdir" "$confdir" "$datadir/applications" "$app_datadir" \
    "$datadir/icons/hicolor" "$udev_rules_dir"
# Older packages could install a private FreeType next to a system Fontconfig.
# Remove both sides so the firmware supplies one internally compatible stack.
rm -f -- "$libdir"/libfontconfig.so* "$libdir"/libfreetype.so*
manifest_tmp=$(mktemp)

install -m 0755 "$script_dir/airan-desk.real" "$bindir/airan-desk.real"
append_manifest "$bindir/airan-desk.real"
install -m 0755 "$script_dir/airan-desk" "$bindir/airan-desk"
append_manifest "$bindir/airan-desk"
install -m 0755 "$script_dir/airan-desk-ensure-uinput-rule" "$bindir/airan-desk-ensure-uinput-rule"
append_manifest "$bindir/airan-desk-ensure-uinput-rule"
install -m 0755 "$script_dir/install-linux.sh" "$app_datadir/install-linux.sh"
append_manifest "$app_datadir/install-linux.sh"
install -m 0755 "$script_dir/remove-linux.sh" "$app_datadir/remove-linux.sh"
append_manifest "$app_datadir/remove-linux.sh"
install -d "$bindir/script"
install -m 0755 "$script_dir/script/airan-notify.sh" "$bindir/script/airan-notify.sh"
install -m 0644 "$script_dir/script/airan-notify.bat" "$bindir/script/airan-notify.bat"
install -m 0644 "$script_dir/script/README.md" "$bindir/script/README.md"
append_manifest "$bindir/script/airan-notify.sh"
append_manifest "$bindir/script/airan-notify.bat"
append_manifest "$bindir/script/README.md"
for document in LICENSE README.md README.en.md; do
    install -m 0644 "$script_dir/$document" "$app_datadir/$document"
    append_manifest "$app_datadir/$document"
done

is_system_font_library()
{
    case "$(basename "$1")" in
        libfontconfig.so*|libfreetype.so*)
            return 0
            ;;
    esac
    return 1
}

if [ -d "$script_dir/conf" ]; then
    find "$script_dir/conf" -type f \( -name '*.ini' -o -name '*.qss' \) | while IFS= read -r file; do
        rel=${file#"$script_dir/conf/"}
        install -d "$confdir/$(dirname "$rel")"
        install -m 0644 "$file" "$confdir/$rel"
        printf '%s\n' "$confdir/$rel" >> "$manifest_tmp"
    done
fi

write_vaapi_driver_config

for lib in "$script_dir"/*.so "$script_dir"/*.so.*; do
    [ -e "$lib" ] || continue
    is_system_font_library "$lib" && continue
    install -m 0644 "$lib" "$libdir/$(basename "$lib")"
    append_manifest "$libdir/$(basename "$lib")"
done

if [ -d "$script_dir/lib" ]; then
    find "$script_dir/lib" -type f \( -name '*.so' -o -name '*.so.*' \) | while IFS= read -r lib; do
        is_system_font_library "$lib" && continue
        rel=${lib#"$script_dir/lib/"}
        install -d "$libdir/$(dirname "$rel")"
        install -m 0644 "$lib" "$libdir/$rel"
        printf '%s\n' "$libdir/$rel" >> "$manifest_tmp"
    done
fi

if [ -d "$script_dir/plugins" ]; then
    rm -rf "$app_prefix/plugins"
    cp -R "$script_dir/plugins" "$app_prefix/plugins"
    find "$app_prefix/plugins" -type f | while IFS= read -r file; do
        printf '%s\n' "$file" >> "$manifest_tmp"
    done
fi

if [ -f "$script_dir/qt.conf" ]; then
    {
        printf '%s\n' '[Paths]'
        printf '%s\n' 'Plugins = ../plugins'
        printf '%s\n' 'Translations = ../share/airan-desk/translations'
    } > "$bindir/qt.conf"
    chmod 0644 "$bindir/qt.conf"
    append_manifest "$bindir/qt.conf"
fi

if [ -d "$script_dir/locale" ]; then
    install -d "$app_datadir/locale"
    find "$script_dir/locale" -type f -name '*.qm' | while IFS= read -r file; do
        install -m 0644 "$file" "$app_datadir/locale/$(basename "$file")"
        printf '%s\n' "$app_datadir/locale/$(basename "$file")" >> "$manifest_tmp"
    done
fi

if [ -d "$script_dir/translations" ]; then
    install -d "$app_datadir/translations"
    find "$script_dir/translations" -type f -name '*.qm' | while IFS= read -r file; do
        install -m 0644 "$file" "$app_datadir/translations/$(basename "$file")"
        printf '%s\n' "$app_datadir/translations/$(basename "$file")" >> "$manifest_tmp"
    done
fi

if [ -d "$script_dir/icons/hicolor" ]; then
    cp -R "$script_dir/icons/hicolor/." "$datadir/icons/hicolor/"
    find "$script_dir/icons/hicolor" -type f | while IFS= read -r file; do
        rel=${file#"$script_dir/icons/hicolor/"}
        printf '%s\n' "$datadir/icons/hicolor/$rel" >> "$manifest_tmp"
    done
fi

if [ -f "$script_dir/airan-desk.desktop" ]; then
    sed "s#^Exec=.*#Exec=$bindir/airan-desk#" "$script_dir/airan-desk.desktop" \
        > "$datadir/applications/airan-desk.desktop"
    chmod 0644 "$datadir/applications/airan-desk.desktop"
    append_manifest "$datadir/applications/airan-desk.desktop"
fi

if [ -f "$script_dir/airan-desk-autostart.desktop" ]; then
    sed "s#^Exec=.*#Exec=$bindir/airan-desk --start-in-tray --delaystart 5#" "$script_dir/airan-desk-autostart.desktop" \
        > "$app_datadir/airan-desk-autostart.desktop"
    chmod 0644 "$app_datadir/airan-desk-autostart.desktop"
    append_manifest "$app_datadir/airan-desk-autostart.desktop"
fi

install -m 0644 "$script_dir/60-airan-desk-uinput.rules" \
    "$app_datadir/60-airan-desk-uinput.rules"
append_manifest "$app_datadir/60-airan-desk-uinput.rules"
AIRAN_DESK_UINPUT_RULE_TARGET="$udev_rules_dir/60-airan-desk-uinput.rules" \
    "$bindir/airan-desk-ensure-uinput-rule" \
    "$app_datadir/60-airan-desk-uinput.rules"
append_manifest "$udev_rules_dir/60-airan-desk-uinput.rules"

if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -t -f "$datadir/icons/hicolor" || true
fi

if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database "$datadir/applications" || true
fi

if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ] && [ -f "$app_datadir/airan-desk-autostart.desktop" ]; then
    user_home=""
    if command -v getent >/dev/null 2>&1; then
        user_home=$(getent passwd "$SUDO_USER" | cut -d: -f6 || true)
    fi
    if [ -z "$user_home" ]; then
        user_home=${SUDO_HOME:-}
    fi
    if [ -z "$user_home" ]; then
        user_home="/home/$SUDO_USER"
    fi
    if [ -n "$user_home" ]; then
        user_group=$(id -gn "$SUDO_USER" 2>/dev/null || printf '%s' "$SUDO_USER")
        user_autostart_dir="$user_home/.config/autostart"
        install -d -o "$SUDO_USER" -g "$user_group" "$user_autostart_dir"
        rm -f -- "$user_autostart_dir/airan-desk.desktop"
        install -m 0644 -o "$SUDO_USER" -g "$user_group" \
            "$app_datadir/airan-desk-autostart.desktop" \
            "$user_autostart_dir/airan-desk.desktop"
        append_manifest "$user_autostart_dir/airan-desk.desktop"
    fi
fi

sort -u "$manifest_tmp" > "$manifest"
rm -f "$manifest_tmp"

echo "Airan Desk installed to $bindir."
echo "Airan Desk runtime libraries were installed to $libdir."
echo "The uinput udev rule was installed to $udev_rules_dir."
echo "To uninstall, run: sudo $app_datadir/remove-linux.sh"
echo "Log out and back in if remote keyboard/mouse input is still unavailable."
